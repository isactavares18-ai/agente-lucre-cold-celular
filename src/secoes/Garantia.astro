---
import { titulo, texto, destino, rotuloCta } from "../lib/texto";
const { c } = Astro.props;
const d = c.garantia, img = c.imagens ?? {};
---
<section class="section guarantee" id="garantia">
  <div class="container">
    <div class="guarantee__box reveal" data-reveal="scale">
      <div class="seal" aria-hidden="true">
        {img.selo_garantia && <img src={`/img/${img.selo_garantia}`} alt="" width="300" height="300">}
        <div class="seal__core"><b>{d.dias}</b><span>dias</span></div>
      </div>
      <div>
        <span class="eyebrow">{d.eyebrow ?? "Risco zero"}</span>
        <h2 class="h-section" set:html={titulo(d.titulo)} />
        {d.paragrafos.map((p: string, i: number) => <p class={i === 0 ? "lead" : undefined} set:html={texto(p)} />)}
        {d.selos?.length > 0 && <div class="guarantee__pills" data-stagger>{d.selos.map((s: string) => <span>{s}</span>)}</div>}
        {d.nota && <p class="guarantee__small">“{d.nota}”</p>}
        <div class="cta-block" style="align-items:flex-start">
          <a href={destino(d.cta, c.config.checkout_url)} class="btn btn--gold" data-cta="garantia">
            {rotuloCta(d.cta)}<span class="btn__icon"><svg><use href="#i-arrow"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
