---
// Layout base: <head>, tema, pixel, player da VSL e controle do delay.
import Icones from "../secoes/Icones.astro";
import { cssDoTema, urlFontes, fontesProprias, type Tema } from "../lib/tema";

interface Props { c: any; tema: Tema; titulo?: string; descricao?: string }
const { c, tema, titulo, descricao } = Astro.props;
const cfg = c.config;
const img = c.imagens ?? {};

const temDelay = Number(cfg.delay_segundos) > 0;
const varsImagens = [
  img.hero_fundo && `--img-hero:url("/img/${img.hero_fundo}")`,
  img.diferente_fundo && `--img-diferente:url("/img/${img.diferente_fundo}")`,
  img.final_fundo && `--img-final:url("/img/${img.final_fundo}")`,
].filter(Boolean).join(";");
const googleFonts = urlFontes(tema);
const pageTitle = titulo ?? c.seo?.titulo ?? `${c.aluno.produto} · ${c.aluno.nome}`;
const pageDesc = descricao ?? c.seo?.descricao ?? "";
---
<!doctype html>
<html lang="pt-BR" class:list={["no-js", { "tem-delay": temDelay }]} style={varsImagens || undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta name="theme-color" content={typeof tema.cores.escuro === "string" ? tema.cores.escuro : tema.cores.escuro["900"]}>
  {c.seo?.indexar === false && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={c.seo?.og_descricao ?? pageDesc}>
  {img.og && <meta property="og:image" content={`/img/${img.og}`}>}
  <meta name="twitter:card" content="summary_large_image">
  {img.logo_icone && <link rel="icon" href={`/img/${img.logo_icone}`}>}

  {googleFonts && <link rel="preconnect" href="https://fonts.googleapis.com">}
  {googleFonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>}
  {googleFonts && <link href={googleFonts} rel="stylesheet">}
  {img.hero_fundo && <link rel="preload" as="image" href={`/img/${img.hero_fundo}`}>}
  {cfg.vsl?.tipo === "vturb" && <link rel="preconnect" href="https://scripts.converteai.net">}

  <style is:inline set:html={fontesProprias(tema) + cssDoTema(tema)}></style>
  <link rel="stylesheet" href="/css/style.css">
  <style is:inline>.tem-delay .esconder{display:none}</style>

  <script is:inline>document.documentElement.classList.remove("no-js");</script>

  {cfg.pixel_meta_id && (
    <script is:inline define:vars={{ px: cfg.pixel_meta_id }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', px); fbq('track', 'PageView');
    </script>
  )}
  {cfg.gtm_id && (
    <script is:inline define:vars={{ gtm: cfg.gtm_id }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
    </script>
  )}
</head>
<body>
<div class="scroll-progress" aria-hidden="true"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><Icones /></svg>

<slot />

<script src="/js/vendor/lenis.min.js" defer></script>
<script src="/js/main.js" defer></script>

{cfg.vsl?.script_src && (
  <script is:inline define:vars={{ src: cfg.vsl.script_src }}>
    var s = document.createElement("script"); s.src = src; s.async = true; document.head.appendChild(s);
  </script>
)}

{temDelay && (
  <script is:inline define:vars={{ segundos: Number(cfg.delay_segundos) }}>
    (function () {
      // Delay pelo TEMPO DE VÍDEO ASSISTIDO (recurso da vturb).
      // Em preview (localhost / *.vercel.app), ?semdelay=1 libera tudo para revisão.
      var h = location.hostname;
      var preview = h === "localhost" || h === "127.0.0.1" || /\.vercel\.app$/.test(h);
      var libera = function () { document.documentElement.classList.remove("tem-delay"); window.dispatchEvent(new Event("resize")); };
      if (preview && /[?&]semdelay=1/.test(location.search)) { libera(); return; }

      var player = document.querySelector("vturb-smartplayer");
      if (!player) { console.warn("[delay] player da vturb não encontrado: conteúdo liberado."); libera(); return; }
      player.addEventListener("player:ready", function () {
        if (typeof player.displayHiddenElements === "function") {
          player.displayHiddenElements(segundos, [".esconder"], { persist: true });
        } else {
          console.warn("[delay] displayHiddenElements indisponível: conferir API da vturb.");
        }
      });
    })();
  </script>
)}
</body>
</html>
